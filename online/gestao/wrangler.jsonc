{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "oba-cardapio-gestao",

  "main": "src/index.js",

  "compatibility_date": "2026-08-29",

  "workers_dev": true,

  "preview_urls": false,

    "secrets": {
    "required": [
      "AUTH_PASSWORD",
      "AUTH_SESSION_SECRET",
      "GITHUB_PAT"
    ]
  },
"assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oba-cardapio-catalogo",
      "database_id": "2105b8dd-d5e4-4052-843d-eee15a035e03",
      "migrations_dir": "migrations"
    }
  ]}
